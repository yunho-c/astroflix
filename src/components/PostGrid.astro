---
import PostCard from './PostCard.astro';
import type { PostWithMeta } from '../lib/content';

type Props = {
  posts: PostWithMeta[];
  emptyMessage?: string;
};

const { posts, emptyMessage = 'No stories are available yet.' } = Astro.props;
---

{
  posts.length > 0 ? (
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  ) : (
    <div class="plain-panel empty-state"><p>{emptyMessage}</p></div>
  )
}
