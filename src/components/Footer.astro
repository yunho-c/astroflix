---
import EnvelopeSimple from '@northsoon/phosphor-icons-astro/icons/EnvelopeSimple.astro';
import GithubLogo from '@northsoon/phosphor-icons-astro/icons/GithubLogo.astro';
import GlobeSimple from '@northsoon/phosphor-icons-astro/icons/GlobeSimple.astro';
import Heart from '@northsoon/phosphor-icons-astro/icons/Heart.astro';
import LinkedinLogo from '@northsoon/phosphor-icons-astro/icons/LinkedinLogo.astro';
import Rss from '@northsoon/phosphor-icons-astro/icons/Rss.astro';
import XLogo from '@northsoon/phosphor-icons-astro/icons/XLogo.astro';
import { site, type SocialIcon } from '../data/site';

const socialIcons = {
  email: EnvelopeSimple,
  github: GithubLogo,
  linkedin: LinkedinLogo,
  rss: Rss,
  website: GlobeSimple,
  x: XLogo,
} satisfies Record<SocialIcon, typeof GithubLogo>;

const menuLinks = [
  ...site.nav,
  ...(!site.nav.some((item) => item.href === '/rss.xml') ? [{ href: '/rss.xml', label: 'Feed' }] : []),
];
---

<footer class="site-footer">
  <div class="footer-inner">
    {
      site.social.length > 0 && (
        <p class="footer-social">
          {site.social.map((item) => {
            const Icon = socialIcons[item.icon];
            return (
              <a href={item.href} title={item.label} aria-label={item.label}>
                <Icon size={28} weight={item.icon === 'rss' ? 'regular' : 'fill'} />
              </a>
            );
          })}
        </p>
      )
    }

    <nav aria-label="Footer">
      <ul class="footer-menu">
        {menuLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    {
      site.footer.showThemeCredit && (
        <p class="footer-credit">
          <span>{site.name}</span> carries Jekflix by
          <a href="https://rossener.com" class="creator">Thiago Rossener</a> forward with
          <span class="love" aria-label="love"><Heart size={20} color="var(--accent)" /></span>
        </p>
      )
    }
  </div>
</footer>
