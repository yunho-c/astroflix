---
import { site } from '../data/site';

function getSocialIcon(label: string) {
  const normalizedLabel = label.toLowerCase();
  if (normalizedLabel.includes('github')) return 'github';
  if (normalizedLabel.includes('rss') || normalizedLabel.includes('feed')) return 'rss';
  return 'x';
}

const socialLinks = [
  ...site.social.map((item) => ({
    ...item,
    Icon: getSocialIcon(item.label),
  })),
];

const menuLinks = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/rss.xml', label: 'Feed' },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-social">
      {
        socialLinks.map((item) => {
          return (
            <a href={item.href} title={item.label} aria-label={item.label}>
              {item.Icon === 'github' && <ph-github-logo size="28" weight="fill" aria-hidden="true"></ph-github-logo>}
              {item.Icon === 'rss' && <ph-rss size="28" weight="regular" aria-hidden="true"></ph-rss>}
              {item.Icon === 'x' && <ph-x-logo size="28" weight="fill" aria-hidden="true"></ph-x-logo>}
            </a>
          );
        })
      }
    </p>

    <nav aria-label="Footer">
      <ul class="footer-menu">
        {
          menuLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="footer-credit">
      <span>Jekflix</span> was made with
      <span class="love" aria-label="love">
        <ph-heart size="20" weight="regular" color="var(--accent)" aria-hidden="true"></ph-heart>
      </span>
      by <a href="https://rossener.com" target="_blank" rel="noreferrer" class="creator"
        >Thiago Rossener</a
      >
    </p>
  </div>
</footer>

<script>
  import '@phosphor-icons/webcomponents/PhGithubLogo';
  import '@phosphor-icons/webcomponents/PhHeart';
  import '@phosphor-icons/webcomponents/PhRss';
  import '@phosphor-icons/webcomponents/PhXLogo';
</script>
