---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>
      <strong>{site.name}</strong> rebuilds the Jekflix browsing idea with typed content,
      static-first delivery, and focused interactive details.
    </p>
    <nav class="footer-links" aria-label="Footer">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/rss.xml">RSS</a>
      {site.social.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</footer>
