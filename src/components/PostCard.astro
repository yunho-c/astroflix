---
import { formatDate, getPostPath, slugify, type Author, type PostWithMeta } from '../lib/content';

type Props = {
  post: PostWithMeta;
  author?: Author;
};

const { post, author } = Astro.props;
const categorySlug = slugify(post.data.category);
const postPath = getPostPath(post);
---

<article class="post-card">
  <a class="post-card-category" href={`/categories/${categorySlug}/`}>{post.data.category}</a>
  <div class="post-card-link">
    <a class="post-card-cover" href={postPath} aria-label={`Read ${post.data.title}`}>
      <img src={post.data.image.url} alt={post.data.image.alt} loading="lazy" />
      <span class="read-badge" aria-hidden="true"></span>
    </a>
    <div class="post-card-body">
      <span class="post-card-date">{formatDate(post.data.pubDate)}</span>
      <a class="post-card-title-link" href={postPath}>
        <h3>{post.data.title}</h3>
      </a>
      <a class="post-card-description-link" href={postPath}>
        <p>{post.data.description}</p>
      </a>
      <div class="meta-row">
        <span>{post.minutesToRead} min read</span>
        {author && <span>{author.data.name}</span>}
      </div>
      <div class="tag-row">
        {post.data.tags.slice(0, 3).map((tag) => <a href={`/tags/${slugify(tag)}/`}>#{tag}</a>)}
      </div>
    </div>
  </div>
</article>
