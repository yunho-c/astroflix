---
import { Menu } from '@lucide/astro';
import { site } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <Menu class="menu-icon" size={20} aria-hidden="true" />
    </button>
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span>{site.name}</span>
      <span class="version">v3.1.2</span>
    </a>
    <a class="search-link" href="/search/" aria-label="Search">
      <span aria-hidden="true"></span>
    </a>
    <a class="get-theme" href="https://github.com/thiagorossener/jekflix-template">Get this theme!</a>
  </div>
</header>

<div class="page-overlay" data-menu-overlay></div>

<aside class="sidebar" id="site-nav" aria-label="Primary">
  <h2>Menu</h2>
    <nav class="nav-links" aria-label="Primary">
      {
        site.nav.map((item) => {
          const isCurrent = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <a href={item.href} aria-current={isCurrent ? 'page' : undefined}>
              {item.label}
            </a>
          );
        })
      }
      <a href="/rss.xml">Feed</a>
    </nav>
</aside>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const overlay = document.querySelector<HTMLElement>('[data-menu-overlay]');
  const body = document.body;

  function syncHeaderTone() {
    body.classList.toggle('light', window.scrollY > 0);
  }

  function setOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.setAttribute('data-open', String(open));
    overlay?.setAttribute('data-open', String(open));
    body.classList.toggle('push-menu-to-right', open);
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setOpen(open);
  });

  overlay?.addEventListener('click', () => setOpen(false));
  syncHeaderTone();
  window.addEventListener('scroll', syncHeaderTone, { passive: true });
</script>
