---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'about');
if (!page) {
  throw new Error('Missing required page content: src/content/pages/about.md');
}
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{page.data.eyebrow}</p>
      <h1 class="page-title">{page.data.title}</h1>
      <p class="lede">{page.data.lede}</p>
      <div class="plain-panel page-copy content-offset">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>
