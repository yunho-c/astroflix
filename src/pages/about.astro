---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About the Jekflix Astro project.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Project</p>
      <h1 class="page-title">A modern Jekflix reproduction</h1>
      <p class="lede">
        This Astro build preserves the original idea of a Netflix-inspired editorial theme while using typed content,
        static routes, accessible components, and a maintainable design system.
      </p>
      <div class="plain-panel content-offset">
        <p>
          The experience is content-first: a cinematic homepage, dense post cards, live local search,
          author pages, tag and category archives, article progress, sharing, and related recommendations.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
