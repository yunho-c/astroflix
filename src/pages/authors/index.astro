---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { getAuthors, getPosts } from '../../lib/content';

const authors = await getAuthors();
const posts = await getPosts();
---

<BaseLayout title="Authors" description={`Meet the ${site.name} authors.`}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Staff</p>
      <h1 class="page-title">Authors</h1>
      <p class="lede">The people shaping this editorial catalog.</p>
      {
        authors.length > 0 ? (
          <div class="post-grid content-offset">
            {authors.map((author) => {
              const count = posts.filter((post) => post.data.author === author.id).length;
              return (
                <a class="post-card" href={`/authors/${author.id}/`}>
                  <img src={author.data.avatar.url} alt={author.data.avatar.alt} loading="lazy" />
                  <div class="post-card-body">
                    <p class="eyebrow">{author.data.role}</p>
                    <h3>{author.data.name}</h3>
                    <p>{author.data.bio}</p>
                    <p>{count} stories</p>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="plain-panel empty-state content-offset"><p>Author profiles appear here after they are added.</p></div>
        )
      }
    </div>
  </section>
</BaseLayout>
