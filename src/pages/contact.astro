---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Contact Jekflix Astro.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1 class="page-title">Send a signal</h1>
      <p class="lede">A static-friendly contact form route that can be wired to any form backend.</p>
      <form class="plain-panel search-panel" action="/message-sent/" method="get">
        <label>
          <span class="eyebrow">Name</span>
          <input class="search-input" name="name" required />
        </label>
        <label>
          <span class="eyebrow">Email</span>
          <input class="search-input" type="email" name="email" required />
        </label>
        <label>
          <span class="eyebrow">Message</span>
          <textarea class="search-input" name="message" rows="6" required></textarea>
        </label>
        <button class="button" type="submit">Send message</button>
      </form>
    </div>
  </section>
</BaseLayout>
