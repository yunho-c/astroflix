---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostGrid from '../components/PostGrid.astro';
import {
  formatDate,
  getAllCategories,
  getAllTags,
  getAuthorMap,
  getFeaturedPost,
  getPostPath,
  getPosts,
} from '../lib/content';

const posts = await getPosts();
const authors = await getAuthorMap();
const featured = await getFeaturedPost();
const latestPosts = posts.filter((post) => post.id !== featured.id).slice(0, 6);
const tags = getAllTags(posts).slice(0, 8);
const categories = getAllCategories(posts);
const featuredAuthor = authors.get(featured.data.author);
---

<BaseLayout title="Home" description="A cinematic Astro publication inspired by Jekflix." bodyClass="main-page">
  <section class="hero" aria-labelledby="featured-title">
    <img class="hero-media" src={featured.data.image.url} alt={featured.data.image.alt} />
    <div class="container hero-content">
      <div class="hero-copy">
        <p class="eyebrow">{formatDate(featured.data.pubDate)}</p>
        <h1 id="featured-title" class="hero-title">{featured.data.title}</h1>
        <p class="hero-subtitle">{featured.data.subtitle}</p>
        <div class="meta-row">
          <span class="meta-pill">{featured.data.category}</span>
          <span>{featured.minutesToRead} min read</span>
          <span>{formatDate(featured.data.pubDate)}</span>
          {featuredAuthor && <span>{featuredAuthor.data.name}</span>}
        </div>
        <div class="meta-row">
          <a class="button" href={getPostPath(featured)}>Read feature</a>
          <a class="button secondary" href="/search/">Search archive</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Latest</p>
          <h2 class="section-title">New in the catalog</h2>
        </div>
        <a class="button secondary" href="/tags/">Browse tags</a>
      </div>
      <PostGrid posts={latestPosts} authors={authors} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Discovery</p>
          <h2 class="section-title">Browse by signal</h2>
        </div>
      </div>
      <div class="compact-grid">
        {categories.map((category) => (
          <a class="index-link" href={`/categories/${category.slug}/`}>
            {category.name}
            <span>{category.count}</span>
          </a>
        ))}
        {tags.map((tag) => (
          <a class="index-link" href={`/tags/${tag.slug}/`}>
            #{tag.name}
            <span>{tag.count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
