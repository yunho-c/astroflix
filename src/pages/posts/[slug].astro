---
import { render } from 'astro:content';
import AuthorPanel from '../../components/AuthorPanel.astro';
import PostGrid from '../../components/PostGrid.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getAuthorMap, getPosts, getRelatedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const posts = await getPosts();
const authors = await getAuthorMap();
const author = authors.get(post.data.author);
const relatedPosts = getRelatedPosts(post, posts, 3);
const pathname = `/posts/${post.id}/`;
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image.url} pathname={pathname}>
  <ReadingProgress />
  <header class="article-hero" style={`--image: url('${post.data.image.url}')`}>
    <div class="container">
      <p class="eyebrow">{post.data.category}</p>
      <h1 class="page-title">{post.data.title}</h1>
      <p class="lede">{post.data.subtitle}</p>
      <div class="meta-row">
        <span>{formatDate(post.data.pubDate)}</span>
        <span>{post.minutesToRead} min read</span>
        {author && <span>{author.data.name}</span>}
      </div>
    </div>
  </header>

  <article class="article">
    <Content />
  </article>

  <div class="article-footer">
    <div class="section">
      {author && <AuthorPanel author={author} />}
    </div>
    <ShareLinks title={post.data.title} pathname={pathname} />
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Recommended</p>
          <h2 class="section-title">Keep watching</h2>
        </div>
      </div>
      <PostGrid posts={relatedPosts} authors={authors} />
    </div>
  </section>
</BaseLayout>
