---
import { render } from 'astro:content';
import AuthorPanel from '../../components/AuthorPanel.astro';
import PostGrid from '../../components/PostGrid.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getAuthorMap, getPostPath, getPostSlug, getPosts, getRelatedPosts } from '../../lib/content';
import { blogPostingJsonLd, serializeJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const posts = await getPosts();
const authors = await getAuthorMap();
const author = authors.get(post.data.author);
const relatedPosts = getRelatedPosts(post, posts, 3);
const pathname = getPostPath(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image.url}
  pathname={pathname}
  bodyClass="reading-page"
>
  <ReadingProgress />
  <header class="article-hero">
    <div class="container">
      <div class="meta-row">
        <span class="meta-pill">{post.data.category}</span>
        <span>{formatDate(post.data.pubDate)}</span>
        <span>{post.minutesToRead} min read</span>
        {author && <span>{author.data.name}</span>}
      </div>
      <h1 class="page-title">{post.data.title}</h1>
      <p class="lede">{post.data.subtitle}</p>
      <img class="article-cover" src={post.data.image.url} alt={post.data.image.alt} />
    </div>
  </header>

  <article class="article">
    <Content />
  </article>

  <ShareLinks title={post.data.title} pathname={pathname} />

  <div class="article-footer">
    <div class="section">
      {author && <AuthorPanel author={author} />}
    </div>
  </div>

  <section class="section recommendation-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Recommended</p>
          <h2 class="section-title">Keep Reading</h2>
        </div>
      </div>
      <PostGrid posts={relatedPosts} emptyMessage="There are no additional recommendations yet." />
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={serializeJsonLd(blogPostingJsonLd(post, author))} />
</BaseLayout>
