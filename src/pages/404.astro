---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="The page could not be found.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="page-title">This title left the catalog.</h1>
      <p class="lede">Try search or return to the homepage to keep browsing.</p>
      <div class="meta-row">
        <a class="button" href="/search/">Search archive</a>
        <a class="button secondary" href="/">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
