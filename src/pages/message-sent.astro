---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Submission complete" description="A confirmation page for a configured form provider.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Submission complete</p>
      <h1 class="page-title">Thanks for reaching out.</h1>
      <p class="lede">This confirmation route is available for the form provider configured by the site owner.</p>
      <p><a class="button" href="/">Return home</a></p>
    </div>
  </section>
</BaseLayout>
