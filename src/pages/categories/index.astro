---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { getAllCategories, getPosts } from '../../lib/content';

const categories = getAllCategories(await getPosts());
---

<BaseLayout title="Categories" description={`Browse ${site.name} posts by category.`}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Sections</p>
      <h1 class="page-title">Categories</h1>
      <p class="lede">Jump into the main editorial lanes.</p>
      {
        categories.length > 0 ? (
          <div class="compact-grid content-offset">
            {categories.map((category) => (
              <a class="index-link" href={`/categories/${category.slug}/`}>
                {category.name}
                <span>{category.count}</span>
              </a>
            ))}
          </div>
        ) : (
          <div class="plain-panel empty-state content-offset">
            <p>Categories appear after the first story is published.</p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
