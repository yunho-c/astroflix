---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostGrid from '../components/PostGrid.astro';
import { formatDate, getAuthorMap, getPostPath, getPosts, slugify } from '../lib/content';

const posts = await getPosts();
const authors = await getAuthorMap();
const index = posts.map((post) => {
  const author = authors.get(post.data.author);
  return {
    title: post.data.title,
    description: post.data.description,
    category: post.data.category,
    categoryHref: `/categories/${slugify(post.data.category)}/`,
    tags: post.data.tags.map((tag) => ({
      label: tag,
      href: `/tags/${slugify(tag)}/`,
    })),
    author: author?.data.name ?? '',
    date: formatDate(post.data.pubDate),
    minutes: post.minutesToRead,
    href: getPostPath(post),
    image: post.data.image,
  };
});
---

<BaseLayout title="Search" description="Search the Jekflix Astro story archive.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Live archive</p>
      <h1 class="page-title">Search the catalog</h1>
      <p class="lede">Find stories by title, author, category, tag, or description.</p>

      <div class="search-panel">
        <label class="eyebrow" for="search-input">Search terms</label>
        <input id="search-input" class="search-input" type="search" placeholder="Try search, Astro, recommendations..." autocomplete="off" />
        <div id="result-count" class="meta-row" aria-live="polite"></div>
        <div id="results" class="result-list"></div>
        <noscript>
          <div class="plain-panel">
            <p>Live filtering needs JavaScript. The latest stories are available below.</p>
          </div>
          <PostGrid posts={posts} authors={authors} />
        </noscript>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ index }}>
    const input = document.querySelector('#search-input');
    const results = document.querySelector('#results');
    const count = document.querySelector('#result-count');

    function normalize(value) {
      return value.toLowerCase().trim();
    }

    function appendText(parent, tag, className, text) {
      const element = document.createElement(tag);
      if (className) {
        element.className = className;
      }
      element.textContent = text;
      parent.append(element);
      return element;
    }

    function createResult(item) {
      const card = document.createElement('article');
      card.className = 'post-card';

      const category = document.createElement('a');
      category.className = 'post-card-category';
      category.href = item.categoryHref;
      category.textContent = item.category;

      const link = document.createElement('a');
      link.className = 'post-card-link';
      link.href = item.href;

      const cover = document.createElement('div');
      cover.className = 'post-card-cover';

      const image = document.createElement('img');
      image.src = item.image.url;
      image.alt = item.image.alt;
      image.loading = 'lazy';

      const badge = document.createElement('span');
      badge.className = 'read-badge';
      badge.setAttribute('aria-hidden', 'true');

      const body = document.createElement('div');
      body.className = 'post-card-body';

      appendText(body, 'span', 'post-card-date', item.date);
      appendText(body, 'h3', '', item.title);
      appendText(body, 'p', '', item.description);

      const meta = document.createElement('div');
      meta.className = 'meta-row';
      appendText(meta, 'span', '', `${item.minutes} min read`);
      if (item.author) {
        appendText(meta, 'span', '', item.author);
      }

      const tags = document.createElement('div');
      tags.className = 'tag-row';
      item.tags.slice(0, 3).forEach((tag) => {
        const link = appendText(tags, 'a', '', `#${tag.label}`);
        link.href = tag.href;
      });

      cover.append(image, badge);
      body.append(meta, tags);
      link.append(cover, body);
      card.append(category, link);

      return card;
    }

    function createEmptyState(query) {
      const panel = document.createElement('div');
      panel.className = 'plain-panel';
      appendText(
        panel,
        'p',
        '',
        query
          ? `No matches for "${query}". Try a shorter term, author name, category, or tag.`
          : 'No stories are available yet.',
      );
      return panel;
    }

    function render(items, query = '') {
      if (!results || !count) return;
      count.textContent = `${items.length} result${items.length === 1 ? '' : 's'}`;
      results.replaceChildren(...(items.length > 0 ? items.map(createResult) : [createEmptyState(query)]));
    }

    function search() {
      const query = normalize(input instanceof HTMLInputElement ? input.value : '');
      if (!query) {
        render(index);
        return;
      }
      const terms = query.split(/\s+/);
      render(
        index.filter((item) => {
          const haystack = normalize(
            [item.title, item.description, item.category, item.author, ...item.tags.map((tag) => tag.label)].join(' '),
          );
          return terms.every((term) => haystack.includes(term));
        }),
        query,
      );
    }

    input?.addEventListener('input', search);
    render(index);
  </script>
</BaseLayout>
