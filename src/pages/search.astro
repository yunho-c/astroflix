---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostGrid from '../components/PostGrid.astro';
import { formatDate, getAuthorMap, getPosts } from '../lib/content';

const posts = await getPosts();
const authors = await getAuthorMap();
const index = posts.map((post) => {
  const author = authors.get(post.data.author);
  return {
    title: post.data.title,
    description: post.data.description,
    category: post.data.category,
    tags: post.data.tags,
    author: author?.data.name ?? '',
    date: formatDate(post.data.pubDate),
    minutes: post.minutesToRead,
    href: `/posts/${post.id}/`,
  };
});
---

<BaseLayout title="Search" description="Search the Jekflix Astro story archive.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Live archive</p>
      <h1 class="page-title">Search the catalog</h1>
      <p class="lede">Find stories by title, author, category, tag, or description.</p>

      <div class="search-panel">
        <label class="eyebrow" for="search-input">Search terms</label>
        <input id="search-input" class="search-input" type="search" placeholder="Try search, Astro, recommendations..." autocomplete="off" />
        <div id="result-count" class="meta-row" aria-live="polite"></div>
        <div id="results" class="result-list"></div>
        <noscript>
          <div class="plain-panel">
            <p>Live filtering needs JavaScript. The latest stories are available below.</p>
          </div>
          <PostGrid posts={posts} authors={authors} />
        </noscript>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ index }}>
    const input = document.querySelector('#search-input');
    const results = document.querySelector('#results');
    const count = document.querySelector('#result-count');

    function normalize(value) {
      return value.toLowerCase().trim();
    }

    function appendText(parent, tag, className, text) {
      const element = document.createElement(tag);
      if (className) {
        element.className = className;
      }
      element.textContent = text;
      parent.append(element);
      return element;
    }

    function createResult(item) {
      const card = document.createElement('a');
      card.className = 'post-card';
      card.href = item.href;

      const body = document.createElement('div');
      body.className = 'post-card-body';

      const meta = document.createElement('div');
      meta.className = 'meta-row';
      appendText(meta, 'span', 'meta-pill', item.category);
      appendText(meta, 'span', '', `${item.minutes} min read`);
      appendText(meta, 'span', '', item.date);
      if (item.author) {
        appendText(meta, 'span', '', item.author);
      }

      appendText(body, 'h3', '', item.title);
      appendText(body, 'p', '', item.description);
      body.prepend(meta);
      card.append(body);

      return card;
    }

    function createEmptyState(query) {
      const panel = document.createElement('div');
      panel.className = 'plain-panel';
      appendText(
        panel,
        'p',
        '',
        query
          ? `No matches for "${query}". Try a shorter term, author name, category, or tag.`
          : 'No stories are available yet.',
      );
      return panel;
    }

    function render(items, query = '') {
      if (!results || !count) return;
      count.textContent = `${items.length} result${items.length === 1 ? '' : 's'}`;
      results.replaceChildren(...(items.length > 0 ? items.map(createResult) : [createEmptyState(query)]));
    }

    function search() {
      const query = normalize(input instanceof HTMLInputElement ? input.value : '');
      if (!query) {
        render(index);
        return;
      }
      const terms = query.split(/\s+/);
      render(
        index.filter((item) => {
          const haystack = normalize([item.title, item.description, item.category, item.author, ...item.tags].join(' '));
          return terms.every((term) => haystack.includes(term));
        }),
        query,
      );
    }

    input?.addEventListener('input', search);
    render(index);
  </script>
</BaseLayout>
